PORT=3001
ASE_ML_URL=http://127.0.0.1:8091
NODE_ENV=development
# In production only these exact origins (plus FRONTEND_URL) may call the API from a browser.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=https://your-app.vercel.app
# Number of reverse proxies in front of the API (Render/Railway/ngrok = 1). Used for client IP and rate limits.
TRUST_PROXY=1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=nova_ai

# Required. The API and every worker refuse to start if it is missing, shorter than 32 chars,
# low-entropy, or a known default/placeholder. All instances (API, queue worker, intelligence
# worker) must share the same value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Logs only ever show a 12-char fingerprint, never the secret.
JWT_SECRET=
# Rotation: set the old value here and a new JWT_SECRET, deploy all instances, wait JWT_EXPIRES_IN,
# then remove this. Leave empty after a leak so every old token is rejected (forces re-login).
JWT_SECRET_PREVIOUS=
JWT_EXPIRES_IN=7d
# Encrypts stored SMTP/IMAP passwords. Set this before rotating JWT_SECRET; without it the cipher
# falls back to JWT_SECRET and rotation would make saved sender passwords unreadable.
EMAIL_SECRET_KEY=


GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CLIENT_ID_ALT=

OPENAI_API_KEY=sk-proj-your-openai-api-key
ASE_OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=



RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key


N8N_USER=Nova
N8N_PASSWORD=your_n8n_webhook_password
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/YOUR-PATH-ID

N8N_WEBHOOK_METHOD=POST
N8N_MAIN_WEBHOOK=https://YOUR-N8N-HOST/webhook/YOUR-PATH-ID

NOVA_SENDER_EMAIL=nova@yourdomain.com
NOVA_SENDER_NAME=NOVA AI

PUBLIC_API_URL=http://localhost:3001
LEADS_API_KEY=replace-with-a-long-random-key
LEADS_API_USER_ID=1
LEADS_API_ORG_ID=1
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_ENABLED=true
IMAP_ORGANIZATION_ID=1
# Shared secret inbound-email providers send as the `x-inbound-webhook-secret` header (or Bearer)
# to POST /api/engine/inbound-email. Required in production (503 when unset).
INBOUND_EMAIL_WEBHOOK_SECRET=
# Model used for reply intent fallback and reply drafts. Drafts always wait for human approval.
ASE_REPLY_MODEL=gpt-4o-mini

# Meeting booking. `none` = meetings can be requested/pending but booking fails with
# CALENDAR_NOT_CONFIGURED (never marked booked). `google` = Google Calendar.
CALENDAR_PROVIDER=none
# Calendar used when the meeting has no assigned rep (a rep's calendar id is their user email).
GOOGLE_CALENDAR_DEFAULT_ID=
# Auth option A: OAuth refresh token with calendar scope (client id/secret default to GOOGLE_CLIENT_*).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Auth option B: service account key JSON (raw or base64). With Workspace domain-wide delegation
# set GOOGLE_CALENDAR_IMPERSONATE_REP=true to read/write each rep's own calendar.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_IMPERSONATE_REP=false
# all | externalOnly | none — who Google emails invites/updates to.
GOOGLE_CALENDAR_SEND_UPDATES=all
MEETING_DEFAULT_DURATION_MINUTES=30
N8N_FOLLOWUP_1_WEBHOOK=
N8N_FOLLOWUP_2_WEBHOOK=
N8N_FOLLOWUP_3_WEBHOOK=
N8N_FOLLOWUP_4_WEBHOOK=
REQUEST_TIMEOUT_MS=15000
OPENAI_TIMEOUT_MS=45000


VITE_GOOGLE_SHEETS_ID=
VITE_GOOGLE_SHEETS_NAME=NOVA
VITE_GCP_PROJECT_ID=
VITE_GCP_CLIENT_EMAIL=
VITE_GCP_CLIENT_ID=
GCP_PRIVATE_KEY_ID=
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"


SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


VITE_BACKEND_URL=http://localhost:3001

PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_PHONE_NUMBER=+1234567890
PLIVO_AGENT_API_URL=https://agentflow.plivo.com/v1/account/YOUR_AUTH_ID/flow/YOUR_FLOW_ID
PLIVO_AGENT_AUTH_ID=
PLIVO_AGENT_AUTH_TOKEN=
# Primary/rep phone that rings first on ASE dashboard Click-to-Call (not Agentflow).
PLIVO_TRANSFER_NUMBER=
CLICK_TO_CALL_RING_TIMEOUT_SEC=45
CALLING_BOT_API_URL=
CALLING_BOT_API_KEY=
VOICE_WEBHOOK_SECRET=
VOICE_CALLER_NAME=NOVA AI Voice Assistant

ASE_BRAIN_MODE=ACTIVE
ASE_OPERATING_MODE=FULLY_AUTOMATED
ASE_MIN_TOUCH_GAP_HOURS=2
ASE_AUTO_CALL_ON_OPEN=false
ASE_AUTO_CALL_DELAY_SECONDS=30
ASE_CALL_AFTER_FIRST_EMAIL_DELAY_MINUTES=15
ASE_AUTO_CALL_REVIEW_MODE=false
ASE_ALLOW_BOT_OPEN_CALL=false
# CSV / API / form leads auto-join the default cadence (call first). Set false to require manual enroll.
ASE_AUTO_ENROLL_CADENCE=true
ASE_CALLING_HOURS_START=9
ASE_CALLING_HOURS_END=20
ASE_CALLING_TIMEZONE=Asia/Kolkata
ASE_EMAILS_PER_HOUR=60
ASE_CALLS_PER_HOUR=20
ASE_QUIET_DAYS=14
ASE_BYPASS_TIMING_GATES=false
ASE_SKIP_OUTREACH=0
ASE_RESEARCH_TIMEOUT_MS=8000
ASE_RESEARCH_CACHE_TTL_HOURS=6
ASE_RESEARCH_MODEL=gpt-4o-mini
# OpenAI web search for news/funding/launches (uses OPENAI_API_KEY; billed per search call)
ASE_WEB_SEARCH_ENABLED=false
ASE_WEB_SEARCH_MODEL=gpt-4o-mini
ASE_WEB_SEARCH_DAILY_LIMIT=100
ASE_WEB_SEARCH_LOOKBACK_DAYS=365
ASE_ML_TRAINING_PATH=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_PUBLIC_URL=
# Production: set REDIS_URL and either:
#   ASE_QUEUE_ROLE=all     (API process also runs BullMQ workers), or
#   ASE_QUEUE_ROLE=worker  (run `npm run worker` as a separate process).
# If Redis is set but no worker runs, research/draft jobs stay queued forever.
ASE_QUEUE_ROLE=
