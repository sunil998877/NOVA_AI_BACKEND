PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:5173

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=nova_ai

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (must match frontend REACT_APP_GOOGLE_CLIENT_ID*)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CLIENT_ID_ALT=

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_ASSISTANT_ID=
# Optional legacy / follow-up assistant IDs
# VITE_OPENAI_ASSISTANT_ID=
# VITE_FOLLOWUP_ASSISTANT_ID=

# Google reCAPTCHA v2
# Test keys from Google (always pass): site 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#                                       secret 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# n8n webhook (Basic Auth — not Gmail credentials)
# Use Production URL: /webhook/...  (not /webhook-test/...)
# Prefer N8N_WEBHOOK_URL for campaign send (POST JSON { campaignId })
N8N_USER=Nova
N8N_PASSWORD=your_n8n_webhook_password
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/YOUR-PATH-ID
# GET = only if your n8n Webhook node is GET-only (recipients/body will NOT be in the trigger;
#       n8n must then GET /api/mails/campaign/:id with accessToken). Prefer POST.
N8N_WEBHOOK_METHOD=POST
N8N_MAIN_WEBHOOK=https://YOUR-N8N-HOST/webhook/YOUR-PATH-ID
# Public URL n8n can reach (ngrok / Render). Used in webhook payload as apiBaseUrl.
PUBLIC_API_URL=http://localhost:3001
N8N_FOLLOWUP_1_WEBHOOK=
N8N_FOLLOWUP_2_WEBHOOK=
N8N_FOLLOWUP_3_WEBHOOK=
N8N_FOLLOWUP_4_WEBHOOK=
REQUEST_TIMEOUT_MS=15000
OPENAI_TIMEOUT_MS=45000

# Optional: Google Sheets / GCP (if used by workflows or sheets routes)
VITE_GOOGLE_SHEETS_ID=
VITE_GOOGLE_SHEETS_NAME=NOVA
VITE_GCP_PROJECT_ID=
VITE_GCP_CLIENT_EMAIL=
VITE_GCP_CLIENT_ID=
GCP_PRIVATE_KEY_ID=
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: Supabase (if used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
VITE_BACKEND_URL=http://localhost:3001
