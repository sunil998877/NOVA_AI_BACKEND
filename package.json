{
  "name": "email-marketing-backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "node --check src/server.js",
    "test": "node scripts/run-tests.js unit",
    "check": "node --check src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/queue.worker.js",
    "redis": "node -e \"require('child_process').spawnSync(require('path').join('tools','redis','redis-server.exe'),['--port','6379','--bind','127.0.0.1'],{stdio:'inherit'})\"",
    "train:ase": "node scripts/train_ase_model.js",
    "ml:train": "python ml_service/train_heads.py",
    "ml:serve": "python -m uvicorn ml_service.main:app --host 127.0.0.1 --port 8091",
    "dev": "nodemon --exec node src/server.js",
    "tunnel": "ngrok http 3001",
    "test:live": "node scripts/run-tests.js live",
    "test:all": "node scripts/run-tests.js all"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^2.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "imapflow": "^2.5.2",
    "ioredis": "^6.0.0",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "mailparser": "^3.9.40",
    "marked": "^18.0.11",
    "mysql2": "^3.24.2",
    "nodemailer": "^10.1.7",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.5.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "nodemon": "^1.14.10"
  }
}
